# Public EVM address to monitor. Never put a seed phrase or private key here.
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Required before enabling the production five-minute dry-run cron endpoint.
CRON_SECRET=replace-with-a-long-random-secret

# Upstash Redis REST credentials. Both are required for the 30-day analytics journal and persistent safety stop.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-rest-token
# Vercel Marketplace may provide these equivalent names instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required on Vercel. If omitted, the dashboard fails closed with HTTP 503.
DASHBOARD_USER=sumi
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Paper-only operational safety controls. Use at least 16 random characters.
SAFETY_CONTROL_SECRET=replace-with-a-long-random-secret
# Environment-level override. Invalid values fail closed; true always stops new BUY decisions.
SUMI_EMERGENCY_STOP=false

# Optional public data endpoints.
BLOCKSCOUT_ORIGIN=https://eth.blockscout.com
DEXSCREENER_ORIGIN=https://api.dexscreener.com
GECKOTERMINAL_ORIGIN=https://api.geckoterminal.com/api/v2

# Paper-model assumptions. These never authorize a real transaction.
ESTIMATED_SWAP_GAS_USD=4
ESTIMATED_SLIPPAGE_PERCENT=0.35
ETHEREUM_RPC_URL=
RISK_PER_TRADE_PERCENT=1
MAX_POSITION_PERCENT=20
